bottom:12px;margin-bottom:6px;border-bottom:1px solid var(--line)}\n  .faq-group h3 span{color:var(--deep)}\n  .qa{padding:16px 0;border-bottom:1px dashed var(--line)}\n  .qa:last-child{border-bottom:0}\n  .qa dt{font-weight:700;color:var(--deep);font-size:16px;margin-bottom:6px}\n  .qa dd{margin:0;color:var(--muted);font-size:15px}\n\n  footer{background:var(--deep-3);color:#9fb4c8;padding:34px 0;font-size:13px;border-top:3px solid var(--amber)}\n  footer strong{color:#e8a33d;letter-spacing:.1em}\n  footer p{margin:6px 0 0}\n\n  @media (max-width:860px){\n    .hero-grid{grid-template-columns:1fr;gap:30px}\n    .plan{grid-template-columns:1fr}\n    .plan.lv2,.plan.lv3{margin-right:0}\n    .clients-grid{grid-template-columns:1fr}\n    section{padding:42px 0}\n    .step{grid-template-columns:44px minmax(0,1fr);gap:14px;padding:20px}\n    .step-no{font-size:18px;line-height:44px;border-radius:12px}\n    .panel .row{font-size:13px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div class=\"brandline\">YUKO 冲浪室</div>\n        <nav class=\"anchors\" aria-label=\"页内导航\">\n          <a href=\"#how\">使用说明</a>\n          <a href=\"#plans\">订阅档位</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#faq\">常见问题</a>\n        </nav>\n      </div>\n\n      <div class=\"hero-grid\">\n        <div>\n          <p class=\"eyebrow\">订阅页 · 第 9752 号设计</p>\n          <h1>YUKO冲浪室(YUKO) · <em>YUKO冲浪室</em>：先看清档位，再决定用哪一档。</h1>\n          <p class=\"hero-lead\">三个档位，按流量和同时在线设备数区分。页面把价格、权益、使用顺序和常见问题一次写清，不用来回对照别的页面。</p>\n          <ul class=\"hero-points\">\n            <li>基础版、旗舰版、团队版，逐级递进</li>\n            <li>月付与年付两种付费节奏</li>\n            <li>使用说明按步骤排列，照着走即可</li>\n            <li>问题按主题分组，直接找对应那一条</li>\n          </ul>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"档位速览\">\n          <p class=\"panel-title\">三档速览</p>\n          <dl>\n            <div class=\"row\"><dt>基础版</dt><dd>¥15 / 月 · 100GB</dd></div>\n            <div class=\"row\"><dt>旗舰版</dt><dd>¥35 / 月 · 300GB</dd></div>\n            <div class=\"row\"><dt>团队版</dt><dd>¥85 / 月 · 1000GB</dd></div>\n            <div class=\"row\"><dt>设备上限</dt><dd>3 / 5 / 20 台</dd></div>\n            <div class=\"row\"><dt>付费方式</dt><dd>月付或年付</dd></div>\n          </dl>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">使用说明</span>\n        <h2>四步走完，从选档到上线</h2>\n        <p>顺序别打乱。先定档位，再看设备，再配置，最后才是日常使用中的调整。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"step-no\">1</div>\n          <div>\n            <h3>先数清你的用量</h3>\n            <p>把过去一个月的实际流量和设备数写下来。只用手机和电脑两台，100GB 通常够用；家里几口人共用，就直接看旗舰版。数不清楚，先别急着下单。</p>\n          </div>\n        </article>\n\n        <article class=\"step\">\n          <div class=\"step-no\">2</div>\n          <div>\n            <h3>对着档位表挑一档</h3>\n            <p>重点看两个数字：每月流量和同时在线设备上限。其余权益按档位递进，旗舰版在流媒体与专线方向有额外优化，团队版则偏向多设备与路线定制。</p>\n          </div>\n        </article>\n\n        <article class=\"step\">\n          <div class=\"step-no\">3</div>\n          <div>\n            <h3>装好客户端再配置</h3>\n            <p>按设备系统选择对应客户端，填入订阅信息。先在一台设备上跑通，确认能用，再把同样的配置复制到其余设备，避免几台一起排查。</p>\n          </div>\n        </article>\n\n        <article class=\"step\">\n          <div class=\"step-no\">4</div>\n          <div>\n            <h3>用几天后回来复核</h3>\n            <p>观察实际用量和设备在线情况。如果每月月底都逼近上限，说明该升档；如果常年只用三分之一，降一档更划算。档位不是一次定终身的事。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">订阅档位</span>\n        <h2>三个档位，一级一级往上</h2>\n        <p>价格与权益逐级递增。年付按十个月计，比月付省两个月。</p>\n      </div>\n\n      <div class=\"ladder\">\n\n        <article class=\"plan lv1\">\n          <div>\n            <div class=\"plan-name\">基础版</div>\n            <p class=\"plan-note\">个人单人或双人使用</p>\n            <p class=\"price\">¥15<span>/ 月</span></p>\n            <p class=\"price-alt\">按年付仅需 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan lv2\">\n          <div class=\"plan-badge\">多数人的选择</div>\n          <div>\n            <div class=\"plan-name\">旗舰版</div>\n            <p class=\"plan-note\">家庭共用或对线路要求更高</p>\n            <p class=\"price\">¥35<span>/ 月</span></p>\n            <p class=\"price-alt\">按年付仅需 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan lv3\">\n          <div>\n            <div class=\"plan-name\">团队版</div>\n            <p class=\"plan-note\">小团队、工作室或多设备场景</p>\n            <p class=\"price\">¥85<span>/ 月</span></p>\n            <p class=\"price-alt\">按年付仅需 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plans-foot\">以上为页面展示的档位与价格，付费前请以你实际下单页面上的信息为准。流量与设备数为该档位的上限，不累计、不结转。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">客户端</span>\n        <h2>按设备选客户端，装好再填配置</h2>\n        <p>四条常见设备路径。具体安装包与版本请以你从官方渠道获取的为准，本页不提供下载地址。</p>\n      </div>\n\n      <div class=\"clients-grid\">\n        <article class=\"client\">\n          <h3>桌面端 · Windows</h3>\n          <p>适合长期在电脑前办公的场景。装好后把订阅信息粘进配置页，确认已连接再开浏览器。</p>\n          <span class=\"tag\">配置一次，长期使用</span>\n        </article>\n        <article class=\"client\">\n          <h3>桌面端 · macOS</h3>\n          <p>系统设置里可能需要手动允许网络扩展权限。第一次配置多花两分钟，之后基本不用再动。</p>\n          <span class=\"tag\">注意系统权限提示</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端 · iOS</h3>\n          <p>在应用商店获取对应客户端，导入配置后按提示授权。切换网络时留意重连状态。</p>\n          <span class=\"tag\">移动场景优先</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端 · Android</h3>\n          <p>安装包建议从可信来源获取。导入订阅后先测一个页面能否正常打开，再同步到其他设备。</p>\n          <span class=\"tag\">先测通，再复制</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">常见问题</span>\n        <h2>按主题找答案</h2>\n        <p>分四组：选档、付费、使用、售后。你的问题大概率在某一组里。</p>\n      </div>\n\n      <div class=\"faq-groups\">\n\n        <article class=\"faq-group\">\n          <h3><span>一 ·</span> 关于选档</h3>\n          <dl>\n            <div class=\"qa\">\n              <dt>基础版和旗舰版最实质的差别是什么？</dt>\n              <dd>两处：流量从每月 100GB 提到 300GB，同时在线设备从 3 台提到 5 台。旗舰版另有流媒体解锁范围与专线方向的优化，以及优先工单支持。你的用量若在 100GB 以内、设备不超过 3 台，基础版就够。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>团队版只适合公司吗？</dt>\n              <dd>不是。团队版的判断标准是设备数与流量：20 台同时在线、每月 1000GB，家里设备多、或几个人共用一套订阅，同样适用。它额外提供定制路由与专属客户经理对接。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>用了一阵发现档位不合适，怎么办？</dt>\n              <dd>用实际数据判断：月底是否常逼近流量上限，是否经常因为设备数被挤下线。答案是“是”，就升一档；长期用不满，就降一档。调整方式以你下单页面的说明为准。</dd>\n            </div>\n          </dl>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3><span>二 ·</span> 关于付费</h3>\n          <dl>\n            <div class=\"qa\">\n              <dt>年付比月付便宜多少？</dt>\n              <dd>按页面标价，年付相当于十个月的费用：基础版 ¥150、旗舰版 ¥350、团队版 ¥850，各比十二个月的月付合计少两个月。是否值得年付，取决于你是否确定会用满一年。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>可以先月付试试吗？</dt>\n              <dd>可以。三档都提供月付价格。第一次使用建议先月付一个月，看清实际用量与稳定性，再决定是否转年付。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>页面上的价格是最终价格吗？</dt>\n              <dd>这是本页展示的档位价格，用于横向比较。实际结算金额、可用支付方式与任何优惠，请以下单页面当时显示的信息为准，本页不做承诺。</dd>\n            </div>\n          </dl>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3><span>三 ·</span> 关于使用</h3>\n          <dl>\n            <div class=\"qa\">\n              <dt>一台设备上配置好，怎么弄到其他设备？</dt>\n              <dd>用同一份订阅信息，在各设备的客户端里分别导入。先保证第一台设备跑通，再逐台复制，这样出问题时能立刻判断是配置问题还是设备问题。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>同时在线设备数超了会怎样？</dt>\n              <dd>该档位只允许标明数量的设备同时在线，超出时通常表现为其中一台断开或被挤下线。数一下当前在线的设备，关掉不用的那一台即可。长期不够用，考虑升档。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>换设备、换网络后需要重新配置吗？</dt>\n              <dd>换设备需要在新设备上重新导入配置。换网络一般不需要重配，但切换 Wi-Fi 与移动数据时，留意客户端是否自动重连；若未恢复，手动断开再连接一次。</dd>\n            </div>\n          </dl>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3><span>四 ·</span> 关于售后</h3>\n          <dl>\n            <div class=\"qa\">\n              <dt>遇到问题，先自己排查什么？</dt>\n              <dd>三件事按顺序来：确认客户端显示的连接状态；确认当前设备数没有超过档位上限；换一个网络环境再试一次。这三步能排除大部分常见情况。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>旗舰版和团队版的支持有什么区别？</dt>\n              <dd>旗舰版标注为 7×24 优先工单支持，团队版提供专属客户经理对接。基础版走常规支持渠道。具体的响应时间与渠道，以你实际订阅时收到的说明为准。</dd>\n            </div>\n            <div class=\"qa\">\n              <dt>本页会提供退款承诺或节点列表吗？</dt>\n              <dd>不会。本页只负责把档位、价格、使用顺序和常见问题讲清楚。退款政策、节点清单与线路细节，请查阅官方渠道发布的正式说明。</dd>\n            </div>\n          </dl>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <strong>YUKO 冲浪室</strong>\n    <p>档位、价格与权益以本页展示为准，实际下单信息以下单页面为准。</p>\n    <p>本页面为静态说明页，不提供下载地址与支付入口。</p>\n  </div>\n</footer>",
